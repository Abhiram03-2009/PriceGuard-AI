{
  "appId": "com.priceguard.ai",
  "appName": "PriceGuard AI",
  "webDir": "build",
  "bundledWebRuntime": false,
  "server": {
    "allowNavigation": [
      "api.seatgeek.com",
      "app.ticketmaster.com",
      "text.pollinations.ai",
      "accounts.google.com",
      "appleid.apple.com"
    ],
    "iosScheme": "capacitor"
  },
  "ios": {
    "allowsLinkPreview": true
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  }
}
